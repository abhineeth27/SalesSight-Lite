# Keep the real key in backend/.env only. Never put it in the React app.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key

# Verified against Google's official model and pricing pages on 2026-11-05.
# This stable model is listed with free-tier input and output usage.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional tuning for local development.
ANALYSIS_CACHE_TTL_SECONDS=1800
ANALYSIS_CACHE_MAX_ITEMS=100
GEMINI_TIMEOUT_SECONDS=30

